# LLMServe-Lite 本地推理服务 | deploy/Dockerfile.cpu
# 功能：构建支持 llama.cpp 的 CPU 服务镜像。构建阶段使用预先准备的固定版本源码；
# 运行时从挂载路径读取模型。镜像可以复用，权重文件单独管理。
# 目的：让程序镜像可以复用，同时允许模型作为独立文件挂载和核对。


# 模块：CPU构建
# 功能：源码须先按dependencies.lock.json固定版本准备，不在镜像里下载权重
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake make python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY CMakeLists.txt ./
COPY include include
COPY src src
COPY third_party/httplib third_party/httplib
COPY third_party/nlohmann third_party/nlohmann


# 模块：编译 CPU 后端
# 先拷入固定的 llama.cpp 源码，再打开 LLMSERVE_WITH_LLAMA，得到可以读取 GGUF 的二进制。
COPY third_party/llama.cpp third_party/llama.cpp
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DLLMSERVE_WITH_LLAMA=ON -DGGML_NATIVE=OFF \
    && cmake --build build -j2


# 模块：CPU运行
# 功能：非root用户只读挂载已校验模型，镜像不包含GGUF或本地敏感配置
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /source/build/llmserve /app/llmserve


# 模块：运行配置
# 配置记录权重位置；运行时需要把权重挂到对应路径。反复启动容器无需反复打包权重。
# 镜像里有支持 llama 的程序和配置，运行时还得让配置中的模型路径在容器内可见。排查“宿主机有 GGUF，容器却打不开”时先对照挂载到哪里。
COPY configs/cpu.json /app/config.json
COPY LICENSE /app/licenses/llmserve-LICENSE
COPY third_party/httplib/LICENSE /app/licenses/httplib-LICENSE
COPY third_party/nlohmann/LICENSE /app/licenses/nlohmann-LICENSE
COPY third_party/llama.cpp/LICENSE /app/licenses/llama-LICENSE
USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/llmserve"]
CMD ["/app/config.json"]
